# Variable NAMES with empty or placeholder values only. Never put real values here.
# Real values go in an untracked .env file (ignored by Git) or the host's secret settings.
# Names are provisional until ADR-0005 is approved and task T-011 defines the real list.

# APP_ENV=            (development or production)
# SECRET_KEY=
# ALLOWED_HOSTS=
# DATABASE_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# PUBLIC_BASE_URL=
# IMAGE_STORAGE_PATH=
