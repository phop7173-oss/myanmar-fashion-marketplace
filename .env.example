# Variable NAMES with empty or placeholder values only. Never put real values here.
# To use: copy this file to .env (Git ignores .env), edit .env, then load it:
#   set -a; . ./.env; set +a
# Real values for production go in the host's secret settings, never in this file.

# development or production. Required: the app will not start without it.
APP_ENV=development

# Required in production (at least 50 characters, unique to this site).
# Optional in development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Comma-separated host names the site may be served from. Required in production
# (no '*'). Development defaults to localhost,127.0.0.1.
ALLOWED_HOSTS=localhost,127.0.0.1

# Added by later tasks (names are provisional until then):
# DATABASE_URL=              (T-012)
# IMAGE_STORAGE_PATH=        (T-025)
# TELEGRAM_BOT_TOKEN=        (T-052)
# TELEGRAM_WEBHOOK_SECRET=   (T-052)
